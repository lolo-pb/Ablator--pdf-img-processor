{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@bank/domain": [
        "packages/domain/src/index.ts"
      ],
      "@bank/extraction": [
        "packages/extraction/src/index.ts"
      ],
      "@bank/export": [
        "packages/export/src/index.ts"
      ]
    }
  }
}

